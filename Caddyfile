# Origin for the webconference.bunsenbrenner.org demo. Caddy terminates TLS, so it
# needs NO inbound :80/:443 of its own (reachable only through the tunnel, same as
# CADS-auction-demo/CADS-a2a-demo). Serves the static demo page directly (file_server
# -- no backend bridge, unlike those demos) and reverse-proxies the one dynamic path,
# /ws/channel, to the edge's dedicated browser channel listener
# (ws_channel.rs, CT_EDGE_WS_CHANNEL_LISTEN) on the plane host -- Caddy proxies the
# WebSocket Upgrade transparently, no special config needed.
#
# WEBCONFERENCE_EDGE_WS (env-substituted at container start via Caddy's {$VAR}
# syntax) is the plane host's published ws_channel port, e.g. 203.0.113.10:4437 --
# see CADS-Tunnel's docker/deploy/compose.selfhost.yml EDGE_WS_CHANNEL_PORT.
#
# The cert is issued CORE-side (CADS-Tunnel's scripts/authorize-pipeline.sh, deSEC
# DNS-01 with the operator's zone-wide token) and mounted in as static files -- this
# Caddyfile only ever reads fullchain.pem/privkey.pem, never holds a DNS credential.
#
# 2026-08-04: the tunnel was re-provisioned after its hostname binding was deleted
# (a "Revoke" click on the portal deleted the whole binding, not just reset the cert
# status). A freshly (re-)provisioned tunnel always starts at Rot/Gelb -- the shared
# wildcard tier where the EDGE terminates the customer-facing TLS itself and forwards
# PLAINTEXT to the origin (docs/agent-onboarding.md "Certificate status: Rot/Gelb/
# Grün") -- regardless of whether a valid core-issued cert already sits in
# /certs, since Grün is specifically about the *tunnel's* admission-broker state, not
# about a cert file merely existing. `tls ...` here would make Caddy reject the
# edge's forwarded plaintext as a protocol mismatch ("Client sent an HTTP request to
# an HTTPS server") -- confirmed live. Matches the exact same gotcha
# devsystem-demo's own Caddyfile already documents. Switch back to
# `tls /certs/fullchain.pem /certs/privkey.pem` once this tunnel reaches Grün.
#
# Browser-Plane login gate (optional, CADS-Tunnel #382-follow): CT_GATE_UPSTREAM_HOST
# (e.g. bunsenbrenner.org) points forward_auth at the control plane's own /gate/check.
# The toggle lives entirely server-side (the tunnel owner's portal checkbox) -- this
# block is unconditional and safe to leave in even when the gate is off: an ungated
# hostname's /gate/check always answers 200, so nothing here ever blocks a visitor
# unless the owner has actually turned the gate on for this hostname.
#
# copy_headers forwards /gate/check's X-Gate-Email response header onto the actual
# request Caddy proxies through -- when the gate is on and a visit is admitted, the
# app/bridge sees who's really signed in as a normal incoming request header,
# instead of trusting anything the browser itself could claim. Absent entirely when
# the gate is off (nothing to report), so app-side code must treat a missing header
# as "no verified identity available," not an error.
#
# No handle_errors block: /gate/check issues the login redirect itself (a 302
# straight to /gate/start) when the gate blocks a visit -- forward_auth copies
# that response to the client verbatim. A handle_errors block here never
# actually fired (confirmed against Caddy's own forward_auth docs: a non-2xx
# auth-backend response never reaches Caddy's error pipeline at all) -- caught
# live standing up the first real gated demo, not from re-reading the docs.
#
# auto_https off + the bare `:443` address (rather than the hostname) while
# Gelb: with no `tls` directive, Caddy's default auto_https would otherwise try
# to obtain its OWN Let's Encrypt cert for this hostname on startup -- which
# can never succeed here (this origin has no direct public inbound
# connectivity, only reachable through the tunnel) and would just spam failed
# ACME attempts. `CT_AGENT_ORIGIN=webconference-demo-origin:443` is what the
# tunnel actually forwards to, so this must keep listening on :443, just
# without TLS of its own while Gelb.
{
	auto_https off
}

:443 {
	forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
		uri /gate/check
		copy_headers X-Gate-Email
	}
	reverse_proxy /ws/channel {$WEBCONFERENCE_EDGE_WS}
	root * /srv
	file_server
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
