# Origin for the webconference.bunsenbrenner.org demo. Caddy terminates TLS, so it
# needs NO inbound :80/:443 of its own (reachable only through the tunnel, same as
# CADS-auction-demo/CADS-a2a-demo). Serves the static demo page directly (file_server
# -- no backend bridge, unlike those demos) and reverse-proxies the one dynamic path,
# /ws/channel, to the edge's dedicated browser channel listener
# (ws_channel.rs, CT_EDGE_WS_CHANNEL_LISTEN) on the plane host -- Caddy proxies the
# WebSocket Upgrade transparently, no special config needed.
#
# WEBCONFERENCE_EDGE_WS (env-substituted at container start via Caddy's {$VAR}
# syntax) is the plane host's published ws_channel port, e.g. 203.0.113.10:4437 --
# see CADS-Tunnel's docker/deploy/compose.selfhost.yml EDGE_WS_CHANNEL_PORT.
#
# The cert is issued CORE-side (CADS-Tunnel's scripts/authorize-pipeline.sh, deSEC
# DNS-01 with the operator's zone-wide token) and mounted in as static files -- this
# Caddyfile only ever reads fullchain.pem/privkey.pem, never holds a DNS credential.
#
# 2026-08-04: the tunnel was re-provisioned after its hostname binding was deleted
# (a "Revoke" click on the portal deleted the whole binding, not just reset the cert
# status). A freshly (re-)provisioned tunnel always starts at Rot/Gelb -- the shared
# wildcard tier where the EDGE terminates the customer-facing TLS itself and forwards
# PLAINTEXT to the origin (docs/agent-onboarding.md "Certificate status: Rot/Gelb/
# Grün") -- regardless of whether a valid core-issued cert already sits in
# /certs, since Grün is specifically about the *tunnel's* admission-broker state, not
# about a cert file merely existing. `tls ...` here would make Caddy reject the
# edge's forwarded plaintext as a protocol mismatch ("Client sent an HTTP request to
# an HTTPS server") -- confirmed live. Matches the exact same gotcha
# devsystem-demo's own Caddyfile already documents. Switch back to
# `tls /certs/fullchain.pem /certs/privkey.pem` once this tunnel reaches Grün.
#
# Browser-Plane login gate (optional, CADS-Tunnel #382-follow): CT_GATE_UPSTREAM_HOST
# (e.g. bunsenbrenner.org) points forward_auth at the control plane's own /gate/check.
# The toggle lives entirely server-side (the tunnel owner's portal checkbox) -- this
# block is unconditional and safe to leave in even when the gate is off: an ungated
# hostname's /gate/check always answers 200, so nothing here ever blocks a visitor
# unless the owner has actually turned the gate on for this hostname.
#
# copy_headers forwards /gate/check's X-Gate-Email response header onto the actual
# request Caddy proxies through -- when the gate is on and a visit is admitted, the
# app/bridge sees who's really signed in as a normal incoming request header,
# instead of trusting anything the browser itself could claim. Absent entirely when
# the gate is off (nothing to report), so app-side code must treat a missing header
# as "no verified identity available," not an error.
#
# CADS-webconference-demo#62: copy_headers only OVERWRITES X-Gate-Email when
# /gate/check's response actually sets it -- it never strips. When the gate
# is off (or /gate/check ever admits without setting it), a client-supplied
# X-Gate-Email survives untouched and reaches the bridge, which trusts it
# absolutely (it has no way to tell "the gate set this" from "the client
# claimed this"). The fix (request_header -X-Gate-Email, inside the :443
# block below, running before forward_auth in Caddy's directive order) strips
# any client-asserted value first -- copy_headers then re-sets it only from
# the gate's own verified response, never leaving a smuggled value in place.
# Live-reproduced against a local bridge (client-supplied
# X-Gate-Email: admin@example.org reflected verbatim by /api/whoami) before
# this fix.
#
# No handle_errors block: /gate/check issues the login redirect itself (a 302
# straight to /gate/start) when the gate blocks a visit -- forward_auth copies
# that response to the client verbatim. A handle_errors block here never
# actually fired (confirmed against Caddy's own forward_auth docs: a non-2xx
# auth-backend response never reaches Caddy's error pipeline at all) -- caught
# live standing up the first real gated demo, not from re-reading the docs.
#
# auto_https off + the bare `:443` address (rather than the hostname) while
# Gelb: with no `tls` directive, Caddy's default auto_https would otherwise try
# to obtain its OWN Let's Encrypt cert for this hostname on startup -- which
# can never succeed here (this origin has no direct public inbound
# connectivity, only reachable through the tunnel) and would just spam failed
# ACME attempts. `CT_AGENT_ORIGIN=webconference-demo-origin:443` is what the
# tunnel actually forwards to, so this must keep listening on :443, just
# without TLS of its own while Gelb.
{
	auto_https off
}

:443 {
	# CADS-webconference-demo#62 (fix regression, live-confirmed): Caddyfile
	# directives execute in Caddy's own IMPLICIT priority order, NOT textual
	# order -- forward_auth/reverse_proxy outranks request_header regardless
	# of which is written first (confirmed against the compiled JSON config:
	# without route{}, the header-delete handler for a bare request_header
	# lands AFTER reverse_proxy's own handle_response in the "handle" array).
	# So request_header -X-Gate-Email written before forward_auth here still
	# ran AFTER copy_headers set the gate's real verified value, deleting
	# it -- stripping legitimate identities, not just client-smuggled ones.
	# Exactly the same class of ordering bug Caddyfile.selfservice's own
	# route{} comment already documents for forward_auth vs. its own earlier
	# reverse_proxy probe. route{} forces literal written-order execution,
	# same fix applied there -- confirmed via the compiled JSON here too:
	# wrapped in route{}, the header-delete handler now runs BEFORE
	# reverse_proxy's handle_response.
	# CADS-webconference-demo (live-reported): a brand-new/anonymous visitor
	# used to hit the gate on EVERY request, including the very first static
	# page load -- Caddy 302'd straight to the Keycloak login before the
	# browser ever received index.html, so the app's own landing page (hero,
	# "what's real, what's not", the e-mail entry form) never rendered at
	# all. Only /ws/channel and /api/* actually need a verified identity
	# (the real per-request Keycloak check, CADS-webconference-demo#9/#10) --
	# static asset serving below is intentionally OUTSIDE the gate now
	# (matches Caddyfile.selfservice's own equivalent fix, live-verified
	# there), so the landing page always loads first; a login prompt (via a
	# gated /api/whoami call the client already makes right after showing
	# that screen, see dialer.js's runIdentityScreen) only follows once the
	# app actually needs to know who you are, not before you've seen
	# anything.
	@gated {
		path /ws/channel /api/*
	}
	handle @gated {
		route {
			request_header -X-Gate-Email
			# CADS-webconference-demo#65: header_up -Connection/-Upgrade strip
			# those headers ONLY from this forward_auth call's own outgoing
			# probe request to /gate/check, not from the real request that
			# continues past this block -- without them, a WS-upgrade original
			# request (Connection: Upgrade, Upgrade: websocket -- true for
			# every /api/ws request) carries those same headers onto the
			# /gate/check probe itself, which then gets misinterpreted as an
			# upgrade attempt by the backend instead of a plain GET. Root cause
			# found and fixed the same way in Caddyfile.selfservice (the
			# actually-deployed file) -- see that file's much longer comment on
			# this same block for the full local-repro writeup.
			forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
				uri /gate/check
				copy_headers X-Gate-Email
				header_up -Connection
				header_up -Upgrade
			}
			reverse_proxy /ws/channel {$WEBCONFERENCE_EDGE_WS}
			# CADS-webconference-demo#68: this base Caddyfile had no /api/* proxy
			# at all -- every dialing/presence/contacts/messenger call 404'd
			# (file_server has no such files in /srv). Caddyfile.selfservice
			# already has this same line (its own #62/#68-equivalent history);
			# this base file was just missing it, alongside the bridge service
			# itself (see compose.webconference-demo.yml's webconference-demo-
			# bridge, added in the same fix).
			reverse_proxy /api/* {$WEBCONFERENCE_BRIDGE_ADDR}
		}
	}

	# Ungated: the SPA shell itself (index.html + every JS module + wasm/
	# vendor assets) -- see the comment on @gated above for why this no
	# longer sits behind the login gate. header{}/encode below are declared
	# OUTSIDE any route{} now (same shape as Caddyfile.selfservice, which
	# never had this problem in the first place) -- CADS-webconference-demo#62's
	# second regression only bit the OLD single-route{}-wraps-everything
	# shape; Caddy's default implicit priority order (header/encode before
	# file_server/reverse_proxy, regardless of write position) applies
	# normally here since neither this handle{} nor the @gated one above wrap
	# header{}/encode themselves.
	handle {
		root * /srv
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# See Caddyfile.selfservice's matching block for the full rationale
		# (CADS-webconference-demo#15/#16) -- kept identical here so both
		# variants harden the same way regardless of which one a given
		# tunnel's certificate status has it running.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' stun://stun.l.google.com:19302; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
	}
	encode gzip
}
