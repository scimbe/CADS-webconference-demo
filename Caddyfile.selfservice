# Self-service variant: served through the workflow-maintainer portal account's
# own free-tier tunnel (site-34a13a96.bunsenbrenner.org), not the operator-issued
# webconference.bunsenbrenner.org hostname the base Caddyfile targets. While the
# tunnel is in Gelb (see CADS-Tunnel docs/agent-onboarding.md "Certificate
# status"), the edge terminates external TLS itself with a shared cert and
# relays plain HTTP to the origin -- so this listens on plain :80, no `tls`
# directive, until `ct-agent certificate` reaches Grün and this file gets
# updated to serve its own fullchain.pem/privkey.pem on :443 like the base
# Caddyfile does.
:80 {
	# CADS-webconference-demo#36: a brand-new self-registered user hits the
	# gate's own rejection page (control-plane, a separate repo -- not
	# reachable/editable from here) with no actionable next step. Can't fix
	# that page, but CAN give them somewhere to go: two specific requests
	# carved out of the gate below so they're reachable WITHOUT already
	# being on the allow-list, to submit a request an already-admitted
	# member can approve from inside the real (gated) app. `handle`/`handle`
	# are mutually exclusive -- first match wins -- so this is a real
	# exemption, not just a route that happens to also pass the gate.
	#
	# Deliberately narrow, and deliberately NOT a wildcard -- caught live
	# before this ever shipped: an earlier version of this matcher used
	# `path /api/access-requests/*`, which (path matchers have no concept
	# of HTTP method) ALSO exempted /api/access-requests/approve and
	# /decline from the gate entirely. Those routes' own admin check is a
	# client-asserted callerEmail field, same trust tier as everywhere else
	# in this bridge (see #9/#10) -- with no gate in front of them at all,
	# literally anyone on the internet could have POSTed
	# {email:"attacker@evil.com", callerEmail:"<the real admin's email>"}
	# and self-approved, completely bypassing both the gate AND the
	# "admin-only" check. A second matcher issue caught in the same pass:
	# listing the bare path also exempted GET (path matchers don't
	# distinguish method), which would have let anyone unauthenticated
	# enumerate every pending requester's email. Both closed by matching on
	# method AND the exact path, nothing broader.
	@exempt-page {
		method GET
		path /request-access.html /request-access.js
	}
	@exempt-submit {
		method POST
		path /api/access-requests
	}

	handle @exempt-page {
		root * /srv
		file_server
	}
	handle @exempt-submit {
		reverse_proxy /api/access-requests {$WEBCONFERENCE_BRIDGE_ADDR}
	}

	handle {
	# Browser-Plane login gate (CADS-Tunnel#214): calls the control-plane's
	# public /gate/check for every request. Caddy sets X-Forwarded-Host to
	# this vhost's own Host header automatically, which is exactly what
	# gate_check() reads. Whether this actually enforces anything lives
	# entirely server-side (this tunnel's "Require login" + allow-list
	# setting) -- this call is unconditional, per gate.rs's own doc comment.
	#
	# This is forward_auth's own expanded form (see its Caddyfile docs), not
	# the `forward_auth` shorthand: the shorthand copies a non-2xx auth
	# response straight back to the client, bypassing handle_errors entirely.
	# The @denied branch below converts a 401 into a real Caddy HTTP error so
	# handle_errors can turn it into the Keycloak-login redirect; the @good
	# branch is an intentionally-empty handle_response so a 200 falls through
	# to the actual site content instead of writing gate_check's empty body.
	# Caddyfile directives execute in Caddy's own implicit priority order,
	# NOT textual order -- `route { }` forces these two to run literally
	# in the sequence written. Without it, the second (forward_auth)
	# directive was observed running interleaved with the first, breaking
	# the anonymous-request redirect (verified: a raw 401 with no Location
	# came back instead of the expected 302 once both directives were
	# declared at the top level).
	route {
		# CADS-webconference-demo#62: copy_headers below only OVERWRITES
		# X-Gate-Email when /gate/check's response actually sets it -- it
		# never strips. If a client supplies its own X-Gate-Email (e.g. when
		# the gate is off, or on any /gate/check edge case that admits
		# without setting it), that value would otherwise survive untouched
		# through to the bridge, which trusts it absolutely (it has no way
		# to tell "the gate set this" from "the client claimed this" --
		# live-reproduced against a local bridge, client-supplied
		# X-Gate-Email: admin@example.org reflected verbatim by
		# /api/whoami). Stripped here, as the first thing in this route,
		# rather than inside either reverse_proxy's own handle_response --
		# request_header set inside a handle_response block doesn't persist
		# past that handler's own scope (see the comment on the second
		# reverse_proxy below), but a plain request_header at route{} level
		# does, so it stays stripped through both the gate-check probe and
		# the final copy_headers set.
		request_header -X-Gate-Email
		# CADS-webconference-demo#65: ROOT CAUSE of the "/api/ws upgrade gets
		# redirected right after login" bug, found by building a real local
		# repro (caddy:2 + a Node mock backend logging every header it
		# received for /gate/check, both for a plain GET client request and
		# a genuine WS-upgrade client request through this exact Caddyfile
		# shape). When the ORIGINAL client request is itself a WebSocket
		# upgrade (Connection: Upgrade, Upgrade: websocket -- true for every
		# /api/ws request, and true for /api/* in general whenever the
		# browser opens the presence socket), Caddy's reverse_proxy/
		# forward_auth carries those SAME headers onto its own internal
		# probe request to /gate/check by default. The mock backend's own
		# HTTP server then treated the CHECK request itself as an upgrade
		# attempt (routed to its 'upgrade' handler, not the normal request
		# handler) and closed the connection without a valid HTTP response
		# -- reproducing the exact client-visible failure (502/redirect
		# instead of a clean check) with zero timing/session-propagation
		# involved. This has NOTHING to do with session validity or gate
		# state propagating -- gate_check() itself (control-plane
		# crates/control-plane/src/gate.rs) is fully stateless (pure HMAC
		# cookie verification, no store lookup), so there was never a
		# "propagation race" to begin with; the bug is entirely in how the
		# check request is CONSTRUCTED. `header_up -Connection`/`-Upgrade`
		# on both probes below strips them ONLY from each probe's own
		# outgoing sub-request (Caddy's per-handler header_up scoping,
		# confirmed in the same local repro -- verified NOT to affect the
		# real reverse_proxy calls to /ws/channel and /api/* later in this
		# block, which still need Connection/Upgrade intact to actually
		# perform the real WebSocket upgrade). Fixed the actual root cause
		# here instead of only mitigating client-side (see app.js's
		# MAX_INCOMING_SOCKET_ATTEMPTS/reload-on-Reconnect/poll-auto-rearm
		# history for the earlier, now-largely-redundant mitigation layer --
		# left in place as defense in depth, but this is what actually stops
		# the failure from happening in the first place).
		reverse_proxy https://bunsenbrenner.org {
			method GET
			rewrite /gate/check
			header_up -Connection
			header_up -Upgrade
			@good status 2xx
			handle_response @good {
			}
			@denied status 401
			handle_response @denied {
				error 401
			}
		}

		# Second pass, using forward_auth's own shorthand + its documented
		# copy_headers (core's own tested pattern) purely to land
		# X-Gate-Email on the request. `request_header` inside the
		# expanded form's handle_response above resolves {rp.header.*}
		# correctly but does NOT persist past that reverse_proxy handler's
		# own scope (a known Caddy limitation, confirmed both empirically
		# and via the Caddy community) -- this shorthand does. By the time
		# we reach here the block above has already guaranteed a 2xx (or
		# aborted via `error 401` first), so the shorthand's own "return
		# raw failure to client" behavior can't actually trigger here.
		# header_up -Connection/-Upgrade here too -- same #65 root cause,
		# same fix, this probe's own separate outgoing sub-request needs it
		# independently of the one above.
		forward_auth https://bunsenbrenner.org {
			uri /gate/check
			copy_headers X-Gate-Email
			header_up -Connection
			header_up -Upgrade
		}
	}

	reverse_proxy /ws/channel {$WEBCONFERENCE_EDGE_WS}
	reverse_proxy /api/* {$WEBCONFERENCE_BRIDGE_ADDR}
	root * /srv
	file_server
	}

	# handle_errors is NOT an ordered HTTP handler (confirmed live -- Caddy
	# refused to start entirely, crash-looping, when this was nested inside
	# the handle{} block above alongside route{}/reverse_proxy/file_server).
	# Has to stay at this top level, same as the original file before the
	# #36 @exempt split -- it still correctly catches the 401 the route{}
	# block above raises regardless of the handle{}/handle{} nesting, since
	# it scopes to the whole server block, not to one handler.
	handle_errors 401 {
		redir "https://bunsenbrenner.org/gate/start?host={http.request.host}&return={http.request.orig_uri}" 302
	}

	encode gzip
	header {
		X-Content-Type-Options "nosniff"
		# app.js/index.html ship no explicit Cache-Control at all -- Chrome
		# applies RFC 7234 heuristic freshness off Last-Modified alone (can
		# treat a resource as fresh for hours with zero revalidation),
		# meaning a real deploy silently keeps serving whatever JS an open
		# tab already cached. Confirmed live: after a rebuild, several
		# consecutive navigations in the SAME browser profile ran visibly
		# different cached app.js versions depending on per-resource cache
		# state, not the tab's own reload. `no-cache` forces a conditional
		# request (If-None-Match/If-Modified-Since) on every load instead of
		# trusting the heuristic -- Caddy's own ETag/Last-Modified still
		# makes that revalidation cheap (304s, not a full re-fetch) when
		# nothing actually changed.
		Cache-Control "no-cache"
		# CADS-webconference-demo#15/#16: no CSP or other hardening headers
		# existed at all before this. Scoped to what the app actually does --
		# one external module script (index.html has no inline <script>/
		# onclick etc, confirmed by grep before writing this), inline <style>
		# throughout (a full external-stylesheet refactor is its own separate
		# piece of work, not bundled into a security-headers fix), the WASM
		# module fetched same-origin, WebRTC media via getUserMedia +
		# MediaSource (blob:), and the channel signaling WebSocket to this
		# same host (wss: to 'self' is covered by CSP's same-origin match,
		# no separate connect-src entry needed). frame-ancestors 'none' +
		# X-Frame-Options DENY below are deliberately redundant (older
		# browsers only honor the header, CSP is the modern replacement).
		# connect-src includes the public STUN server (CADS-webconference-demo#18)
		# -- WebRTC ICE/STUN gathering is CSP-gated in Chrome/Firefox, so without
		# this entry the STUN fix would be silently defeated by this same policy.
		# img-src includes blob: (CADS-webconference-demo#50) -- an attached
		# image renders via URL.createObjectURL(blob) same as media-src's
		# existing blob: entry already covers for <video>/<audio>; caught
		# live (a real CSP violation in the console, the image just never
		# rendered) before this was added.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' stun://stun.l.google.com:19302; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# camera/microphone stay allowed for this origin itself (self) --
		# the app's entire purpose needs getUserMedia; the actual hardening
		# is denying them to any framed cross-origin content, which
		# frame-ancestors 'none' above already forecloses anyway, but this
		# also blocks e.g. a same-origin future embed from silently reusing
		# camera access it was never granted.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
	}
}
